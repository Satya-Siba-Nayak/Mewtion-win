// Windows Resource Script for Mewtion
1 ICON "mewtion.ico"
IDI_APPLICATION ICON "mewtion.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mewtion"
            VALUE "FileDescription", "Mewtion Vehicle Motion Cues for Windows"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "Mewtion"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Mewtion.exe"
            VALUE "ProductName", "Mewtion for Windows"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
